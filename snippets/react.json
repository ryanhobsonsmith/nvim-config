{
  "Function Component with Props": {
    "prefix": "comp",
    "description": "React function component with typed props; name defaults to filename, tab through name/props/body",
    "body": [
      "type ${1:${TM_FILENAME_BASE}}Props = {$2}",
      "",
      "function ${1}({$3}: ${1}Props) {",
      "  return (",
      "    <div>$0</div>",
      "  )",
      "}",
      "",
      "export default ${1}"
    ]
  },
  "Function Component (no props)": {
    "prefix": "compnp",
    "description": "React function component without props",
    "body": [
      "function ${1:${TM_FILENAME_BASE}}() {",
      "  return (",
      "    <div>$0</div>",
      "  )",
      "}",
      "",
      "export default ${1}"
    ]
  }
}
